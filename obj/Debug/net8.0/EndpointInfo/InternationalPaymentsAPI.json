  "components": {
    "schemas": {
      "CreateUserDTO": {
        "required": [
          "accountNumber",
          "fullName",
          "idNumber",
          "password"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "minLength": 1,
            "pattern": "^[A-Za-z\\s]{3,50}$",
            "type": "string"
          },
          "idNumber": {
            "minLength": 1,
            "pattern": "^\\d{13}$",
            "type": "string"
          },
          "accountNumber": {
            "minLength": 1,
            "pattern": "^[A-Z0-9]{5,10}$",
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginDTO": {
        "required": [
          "accountNumber",
          "password"
        ],
        "type": "object",
        "properties": {
          "accountNumber": {
            "minLength": 1,
            "pattern": "^[A-Z0-9]{5,10}$",
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PaymentDTO": {
        "required": [
          "amount",
          "currency",
          "payeeAccountNumber",
          "provider",
          "swiftCode"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "maximum": 1000000000,
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          },
          "currency": {
            "minLength": 1,
            "pattern": "^[A-Z]{3}$",
            "type": "string"
          },
          "provider": {
            "minLength": 1,
            "pattern": "^[A-Za-z\\s]{2,50}$",
            "type": "string"
          },
          "payeeAccountNumber": {
            "minLength": 1,
            "pattern": "^[A-Z0-9]{6,20}$",
            "type": "string"
          },
          "swiftCode": {
            "minLength": 1,
            "pattern": "^[A-Z0-9]{8,11}$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterDTO": {
        "required": [
          "accountNumber",
          "fullName",
          "idNumber",
          "password"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "minLength": 1,
            "pattern": "^[A-Za-z\\s]{3,50}$",
            "type": "string"
          },
          "idNumber": {
            "minLength": 1,
            "pattern": "^\\d{13}$",
            "type": "string"
          },
          "accountNumber": {
            "minLength": 1,
            "pattern": "^[A-Z0-9]{5,10}$",
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Enter: Bearer {your token}",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}